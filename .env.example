# ─────────────────────────────────────────────────────────────────────────────
# Zebra Reports Service  ·  Environment Variables
# Copy to .env for local development — never commit .env
# In EasyPanel: paste each value in the service's Environment tab
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Service Account (SOLO para Google Chat) ────────────────────────────
# El acceso a Sheets/Drive ya NO usa la service account: migró a OAuth de la
# cuenta central (ver "Acceso a Sheets/Drive" más abajo). La SA se mantiene solo
# para enviar mensajes por Google Chat (los bots de Chat requieren service
# account; no funcionan con OAuth de usuario).
# 1. console.cloud.google.com → IAM & Admin → Service Accounts → Create
# 2. Actions → Manage keys → Add key → JSON → download
# 3. Paste the ENTIRE downloaded JSON as a single line here (no line breaks)
# 4. Agrega la app de Chat de esta SA a cada espacio donde quieras publicar.
GOOGLE_SA_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nCONTENT\n-----END PRIVATE KEY-----\n","client_email":"SERVICE_ACCOUNT@PROJECT.iam.gserviceaccount.com","client_id":"CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/SERVICE_ACCOUNT%40PROJECT.iam.gserviceaccount.com"}

# ── Acceso a Sheets/Drive (OAuth · cuenta central de la agencia) ──────────────
# La app lee las hojas y sube los PDFs actuando como UNA cuenta de Google (la de
# la agencia), autorizada una sola vez. Ventaja sobre la service account: usa la
# cuota de Drive de una cuenta real y puede acceder a "Mi unidad", no solo a
# Unidades Compartidas.
#
# Setup (una vez) — RECOMENDADO: desde la app desplegada:
# 1. Reutiliza el mismo cliente OAuth "Aplicación web" del login (GOOGLE_OAUTH_CLIENT_ID, más abajo).
# 2. En Google Cloud Console → Credenciales → (ese cliente) → "URIs de redirección
#    autorizados", agrega la URL de callback de TU app:
#      https://TU-DOMINIO/api/oauth/google/callback
# 3. Copia el "Secreto de cliente" del mismo cliente OAuth en GOOGLE_OAUTH_CLIENT_SECRET.
# 4. Inicia sesión en la app y visita:  https://TU-DOMINIO/api/oauth/google/start
#    Autoriza con la CUENTA CENTRAL y copia el refresh token que muestra.
# 5. Pégalo en GOOGLE_OAUTH_REFRESH_TOKEN y redespliega.
#
# Alternativa local (si tienes Node en tu máquina): registra el redirect URI
# http://localhost:53682/oauth2callback y ejecuta `npm run oauth:setup`.
#
# Workspace: configura la pantalla de consentimiento como "Interna" para que el
# refresh token NO expire (en modo "Testing" caduca a los 7 días).
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# URL pública de la app (sin barra final). Se usa para armar el redirect_uri del
# setup OAuth de arriba. Si la dejas vacía, se deriva del proxy (X-Forwarded-Proto
# + Host); definirla explícitamente es más robusto.
#   Ejemplo: https://analisis-estrategicos-asesores.zebra-ecosystem.cloud
APP_BASE_URL=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL (clients & schedules persistence) ──────────────────────────────
# When DATABASE_URL is set, clients and automations live in PostgreSQL instead of
# JSON files, so they survive redeploys and stay editable from the UI.
# Leave it BLANK to use the legacy JSON files (local development).
#
# In EasyPanel: create a Postgres service in the SAME project, open it, and copy
# the INTERNAL connection URL. It looks like:
#   postgres://postgres:PASSWORD@<project>_<service>:5432/postgres
# The internal host is on the project's private network (no SSL needed).
DATABASE_URL=

# Set to true ONLY when connecting over a public/external host that requires SSL.
# Leave blank for EasyPanel's internal connection.
DATABASE_SSL=

# ── Autenticación con Google (Sign in with Google) ────────────────────────────
# La app queda ABIERTA mientras GOOGLE_OAUTH_CLIENT_ID esté vacío. Al definirlo,
# el login con Google pasa a ser OBLIGATORIO y solo entran los dominios de abajo.
#
# Cómo obtener el Client ID:
# 1. console.cloud.google.com → APIs y servicios → Pantalla de consentimiento OAuth
#    (tipo "Interno" si usas Google Workspace, así solo entra tu organización).
# 2. Credenciales → Crear credenciales → ID de cliente de OAuth → Aplicación web.
# 3. En "Orígenes de JavaScript autorizados" agrega la URL EXACTA de tu app, p. ej.:
#      https://analisis-estrategicos-asesores.zebra-ecosystem.cloud
#    (y http://localhost:3000 si pruebas en local).
# 4. Copia el "ID de cliente" (termina en .apps.googleusercontent.com) aquí.
GOOGLE_OAUTH_CLIENT_ID=

# Secreto para firmar la cookie de sesión. Usa una cadena larga y aleatoria, p. ej.:
#   openssl rand -hex 32
# Si lo dejas vacío se genera uno al azar en cada arranque (las sesiones se cierran
# al reiniciar). Defínelo para que las sesiones sobrevivan a los redeploys.
AUTH_SESSION_SECRET=

# Dominios de correo permitidos, separados por coma (sin @). Default: zebradigital.marketing
ALLOWED_EMAIL_DOMAINS=zebradigital.marketing

# Ponlo en "true" SOLO para pruebas en http local (desactiva el flag Secure de la
# cookie). En producción (https) déjalo vacío.
AUTH_COOKIE_INSECURE=

# ── Pipeline de llamadas (Callpicker → Postgres → transcripción → análisis) ───
# Sustituye a los flujos de n8n. El barrido arranca solo si hay base de llamadas,
# y lo que decide si un origen se procesa es su interruptor en Ajustes →
# Análisis automático: aquí ya no hay ninguna variable que lo encienda o apague.
#
# Aquí vivía CALLS_PIPELINE. Se quitó porque era invisible desde la app: estuvo
# un día entero en "off" con las llamadas acumulándose y nadie lo notó.
#
# Freno de mano SOLO para desarrollo: con CALLS_SWEEP=off este proceso no barre.
# Hace falta porque el interruptor de Ajustes vive en la base COMPARTIDA, así que
# un `npm run dev` con las llaves reales se pondría a transcribir llamadas de
# producción, y apagarlo desde la UI lo apagaría para todos. En producción se
# deja vacío.
CALLS_SWEEP=

# Base donde Callpicker escribe las llamadas. Es un servicio Postgres DISTINTO
# del de DATABASE_URL: un schema por cliente (Midstorage_callpicker.llamadas) y
# el registro de cuentas en callpicker_registro.cuentas.
#
# Un cliente se procesa cuando su schema tiene tabla `analisis`. Crearla es lo
# que lo habilita y borrarla lo apaga: no hay lista de clientes que mantener
# aparte, porque la condicion es la realidad misma. Para dar de alta uno nuevo:
#
#   CREATE TABLE "<Esquema>".analisis (
#     cuenta TEXT NOT NULL, call_id TEXT NOT NULL,
#     estado TEXT NOT NULL DEFAULT 'pendiente'
#            CHECK (estado IN ('pendiente','descartada','transcrita','analizada','fallida')),
#     transcripcion TEXT, tipo_contacto TEXT, presentacion TEXT, precalif TEXT,
#     exploracion TEXT, agenda TEXT, analisis TEXT,
#     calif_global INTEGER GENERATED ALWAYS AS (
#       CASE WHEN analisis = 'Buzon de voz' THEN NULL
#       ELSE (CASE WHEN presentacion ~* '^s[ii]' THEN 10 ELSE 0 END)
#          + (CASE WHEN precalif     ~* '^s[ii]' THEN 25 ELSE 0 END)
#          + (CASE WHEN exploracion  ~* '^s[ii]' THEN 30 ELSE 0 END)
#          + (CASE WHEN agenda       ~* '^s[ii]' THEN 35 ELSE 0 END) END) STORED,
#     error TEXT, intentos INTEGER NOT NULL DEFAULT 0,
#     procesado_at TIMESTAMPTZ, creado_en TIMESTAMPTZ NOT NULL DEFAULT now(),
#     PRIMARY KEY (cuenta, call_id));
#
# (el CHECK y la formula llevan tildes en la version real: 'Buzon' es 'Buzón' y
#  ^s[ii] es ^s[ií]; aqui van sin acento por compatibilidad del fichero)
CALLS_DATABASE_URL=

# Solo se procesan llamadas desde esta fecha (YYYY-MM-DD). El histórico completo
# puede ser de cientos de horas de audio, y eso no se lanza sin decidirlo.
CALLS_DESDE=2026-08-01

# Transcripción del audio (gemini-3.5-flash, el mismo modelo que usa n8n).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Análisis de la transcripción (gpt-4o-mini, el mismo que usa n8n).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── ZCIS · el panel donde vive la oferta de cada cliente ─────────────────────
# Opcional. Sin la llave, el botón "Traer oferta" no aparece y el contexto del
# negocio se escribe a mano, que es como funciona para los clientes que no están
# en ZCIS. La llave da acceso a la oferta de TODOS los clientes (posicionamiento,
# precios, argumentos de venta): vive solo aquí, el navegador nunca la ve.
ZCIS_BASE_URL=https://panel.zebra-ecosystem.cloud
ZCIS_API_KEY=
