{
  "name": "zebra-reports",
  "version": "1.0.0",
  "description": "Zebra High Performance — Sales Call Report Generator",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dry-run": "tsx src/cli/dry-run.ts",
    "oauth:setup": "tsx src/cli/oauth-setup.ts",
    "migrate:db": "tsx src/cli/migrate-to-db.ts",
    "backfill:metrics": "tsx src/cli/backfill-metrics.ts",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "docs:generate": "node scripts/generate-doc.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "eta": "^3.5.0",
    "express": "^4.21.2",
    "googleapis": "^148.0.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "playwright": "^1.52.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
