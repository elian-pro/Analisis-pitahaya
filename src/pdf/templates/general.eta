<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte de equipo · <%= it.cliente %> · <%= it.mes_label %></title>
<style>
  <%~ it._fontsCss %>

  /* ── Zebra Design System · tokens (impresión = siempre light) ─────────────── */
  :root {
    --bg: #FFFFFF; --surface: #FFFFFF; --surface-2: #F9FAFB;
    --text: #0A0A0A; --text-muted: #737373; --accent: #0A0A0A;
    --ink-200: #E5E5E5; --ink-700: #262626;
    --border: rgba(10,10,10,.10); --border-strong: rgba(10,10,10,.14);
    --r-card: 12px; --r-chip: 6px; --r-control: 8px;
    --sans: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;

    /* Semáforo (acentos semánticos, AA sobre blanco) — la única inyección de color */
    --pos: #1E6B30;      --pos-bg: #E9F3EC;   --pos-bd: #C4E2CD;
    --danger: #B4231C;   --danger-bg: #FBEBEA; --danger-bd: #F0CFCD;
    --warn: #8A6300;     --warn-bg: #FBF3DA;   --warn-bd: #ECDDA8;
    --orange: #B35A00;   --orange-bg: #FBEEDD; --orange-bd: #F0D6B4;
  }

  @page {
    size: A4;
    margin: 12mm 0 16mm 0;
    @bottom-right {
      content: counter(page) " / " counter(pages);
      font-family: 'JetBrains Mono', monospace;
      font-size: 8pt; color: #9a9a9a; padding: 0 18mm 0 0;
    }
    @bottom-left {
      content: "ZEBRA · Inteligencia Comercial";
      font-family: 'JetBrains Mono', monospace;
      font-size: 7.5pt; letter-spacing: .12em; color: #b4b4b4; padding: 0 0 0 18mm;
    }
  }
  @page :first { margin-top: 0; }

  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    font-family: var(--sans); font-size: 10pt; color: var(--text);
    margin: 0; line-height: 1.5; orphans: 3; widows: 3;
    font-feature-settings: 'cv05' 1, 'ss01' 1;
  }

  .eyebrow {
    font-family: var(--mono); font-size: 7.5pt; font-weight: 500;
    text-transform: uppercase; letter-spacing: .2em; color: var(--text-muted);
  }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

  /* ── Membrete (superficie de énfasis: negra en light, ZR-25) ─────────────── */
  .membrete {
    position: relative; overflow: hidden;
    background: var(--text); color: #fff;
    padding: 20mm 18mm 14mm 18mm; page-break-after: avoid;
    isolation: isolate;
  }
  .membrete .motif {
    position: absolute; inset: 0 0 0 auto; width: 42%; height: 100%;
    background-image: url("data:image/png;base64,<%= it._motifB64 %>");
    background-size: cover; background-position: right center;
    opacity: .10; z-index: -1; pointer-events: none;
  }
  .membrete img.logo { height: 22pt; display: block; margin: 0 0 12pt -1pt; }
  .membrete .eyebrow { color: rgba(255,255,255,.62); }
  /* Tipo de reporte: es lo que distingue un membrete de otro, asi que va en
     blanco pleno y por encima del nombre, no escondido en el eyebrow. */
  .membrete .tipo-line { font-family: var(--mono); font-size: 11pt; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: #fff; display: block; margin-bottom: 3pt; }
  .membrete .titulo { font-size: 21pt; font-weight: 600; letter-spacing: -.02em; margin: 14pt 0 2pt 0; }
  .membrete .sub { font-size: 9.5pt; color: rgba(255,255,255,.72); font-family: var(--mono); letter-spacing: .02em; }
  .membrete .meta {
    margin-top: 16pt; border-top: 1px solid rgba(255,255,255,.14); padding-top: 10pt;
    display: flex; gap: 28pt; font-size: 8pt; color: rgba(255,255,255,.6);
  }
  .membrete .meta b { color: #fff; font-weight: 600; }

  main { padding: 9mm 18mm 6mm 18mm; }

  section { margin-top: 15pt; }
  section > .eyebrow { display: block; margin-bottom: 7pt; }
  h2.title { font-size: 12.5pt; font-weight: 600; letter-spacing: -.01em; margin: 0 0 7pt 0; page-break-after: avoid; }

  /* ── KPI cards ────────────────────────────────────────────────────────────── */
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8pt; margin-bottom: 4pt; }
  .kpi {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card);
    padding: 11pt 12pt; page-break-inside: avoid;
  }
  .kpi .label { display: block; margin-bottom: 7pt; }
  .kpi .value { font-family: var(--mono); font-weight: 700; font-size: 23pt; letter-spacing: -.03em; line-height: 1; color: var(--text); }
  .kpi .value .unit { font-size: 10pt; font-weight: 500; color: var(--text-muted); letter-spacing: 0; }
  .kpi .foot { font-size: 7.5pt; color: var(--text-muted); margin-top: 5pt; }
  .kpi.tend .value { font-size: 15pt; letter-spacing: -.01em; }

  /* ── Resumen ejecutivo ────────────────────────────────────────────────────── */
  .resumen {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card);
    padding: 13pt 15pt; margin-top: 4pt; page-break-inside: avoid;
  }
  .resumen .eyebrow { display: block; margin-bottom: 8pt; }
  .var-list { list-style: none; margin: 0 0 2pt 0; padding: 0; }
  .var-list li { display: flex; align-items: baseline; gap: 7pt; margin-bottom: 3pt; font-size: 9pt; }
  .arrow { font-family: var(--mono); font-weight: 700; min-width: 9pt; flex-shrink: 0; text-align: center; }
  .arrow.up   { color: var(--pos); }
  .arrow.down { color: var(--danger); }
  .arrow.flat { color: var(--text-muted); }
  .arrow.na   { color: #b4b4b4; font-weight: 400; }
  .var-list b { font-weight: 600; }
  .down-txt { color: var(--danger); font-weight: 600; }
  .up-txt { color: var(--pos); font-weight: 600; }
  .divisor { border: none; border-top: 1px solid var(--border); margin: 10pt 0 9pt 0; }
  .resumen p { margin: 0; font-size: 9.5pt; line-height: 1.6; }

  /* ── Tablas ───────────────────────────────────────────────────────────────── */
  .table-wrap { border: 1px solid var(--border); border-radius: var(--r-card); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; }
  thead { display: table-header-group; }
  th {
    background: var(--text); color: #fff; text-align: left; vertical-align: middle;
    font-family: var(--mono); font-weight: 500; font-size: 7pt;
    text-transform: uppercase; letter-spacing: .09em; padding: 7pt 9pt;
  }
  td { padding: 7pt 9pt; border-top: 1px solid var(--border); vertical-align: top; line-height: 1.5; }
  tbody tr:nth-child(even) td { background: var(--surface-2); }
  tr { page-break-inside: avoid; break-inside: avoid; }
  .table-wrap + .table-wrap { margin-top: 8pt; }

  /* ── Chips de nivel (semánticos) / pills de prioridad (monocromáticos) ─────── */
  .chip {
    display: inline-block; font-family: var(--mono); font-size: 6.5pt; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em; padding: 2pt 7pt;
    border-radius: var(--r-chip); border: 1px solid var(--border-strong); color: var(--text); white-space: nowrap;
  }
  /* Sin rojo a proposito: el nivel mas bajo describe una etapa, no una alarma.
     El penultimo va neutro para que el salto al ambar no se lea como castigo. */
  .chip.nivel-elite,
  .chip.nivel-alto_desempeno   { background: var(--pos-bg);    color: var(--pos);    border-color: var(--pos-bd); }
  .chip.nivel-consistente      { background: var(--warn-bg);   color: var(--warn);   border-color: var(--warn-bd); }
  .chip.nivel-en_progreso      { background: var(--surface-2); color: var(--text-muted); border-color: var(--border-strong); }
  .chip.nivel-punto_de_partida { background: var(--orange-bg); color: var(--orange); border-color: var(--orange-bd); }

  .pill {
    display: inline-block; font-family: var(--mono); font-size: 6.5pt; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em; padding: 2pt 8pt; border-radius: var(--r-chip); white-space: nowrap;
  }
  .pill.alta  { background: var(--text); color: #fff; border: 1px solid var(--text); }
  .pill.media { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
  .pill.baja  { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }

  /* ── Dos columnas: fortalezas (verde) / áreas (rojo) ──────────────────────── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; page-break-inside: avoid; }
  .panel {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 12pt 13pt;
  }
  .panel .eyebrow { display: block; margin-bottom: 9pt; }
  .panel ul { list-style: none; margin: 0; padding: 0; }
  .panel li { position: relative; padding-left: 13pt; margin-bottom: 8pt; font-size: 8.7pt; line-height: 1.5; }
  .panel li:last-child { margin-bottom: 0; }
  .panel li::before { content: ""; position: absolute; left: 0; top: 5pt; width: 6pt; height: 6pt; border-radius: 1.5px; }
  .panel.pos { border-top: 2px solid var(--pos); }
  .panel.pos .eyebrow { color: var(--pos); }
  .panel.pos li::before { background: var(--pos); }
  .panel.opp { border-top: 2px solid var(--danger); }
  .panel.opp .eyebrow { color: var(--danger); }
  .panel.opp li::before { background: var(--danger); }
  .panel li b { font-weight: 600; }

  .col-asesor { white-space: nowrap; font-weight: 600; }
  .delta.up   { color: var(--pos); font-weight: 600; }
  .delta.down { color: var(--danger); font-weight: 600; }
</style>
</head>
<body>

<%
const TEND = { mejora: '↑ Mejora', estable: '→ Estable', mixto: '↕ Mixto', retroceso: '↓ Retroceso', primer_mes: 'Primer periodo' };
const arrowClass = function(t){ return t === 'mejora' ? 'up' : t === 'baja' ? 'down' : t === 'estable' ? 'flat' : 'na'; };
const arrowChar  = function(t){ return t === 'mejora' ? '↑' : t === 'baja' ? '↓' : t === 'estable' ? '→' : '·'; };
const fmtDelta   = function(n){ return (n >= 0 ? '+' : '') + n; };
%>

<header class="membrete">
  <span class="motif"></span>
  <% if (it._logoB64) { %>
    <img class="logo" src="data:image/png;base64,<%= it._logoB64 %>" alt="ZEBRA">
  <% } %>
  <span class="tipo-line">Análisis de Llamadas</span>
  <span class="eyebrow">Inteligencia Comercial</span>
  <div class="titulo"><%= it.cliente %></div>
  <div class="sub"><%= it.mes_label %><% if (it.period_label) { %> · <%= it.period_label %><% } %> · Reporte de equipo</div>
  <div class="meta">
    <div><b>Asesores</b> · <%= it.total_asesores %></div>
    <div><b>Llamadas</b> · <%= it.total_llamadas %></div>
    <div><b>Generado</b> · <%= it.generated_date %></div>
  </div>
</header>

<main>

  <!-- ── KPIs ──────────────────────────────────────────────────────────────── -->
  <section style="margin-top:0;">
    <div class="kpis">
      <div class="kpi">
        <span class="eyebrow label">Promedio equipo</span>
        <div class="value"><%= it.avg_score_equipo %><span class="unit">/100</span></div>
        <div class="foot">score global del periodo</div>
      </div>
      <div class="kpi">
        <span class="eyebrow label">Asesores</span>
        <div class="value"><%= it.total_asesores %></div>
        <div class="foot">evaluados</div>
      </div>
      <div class="kpi">
        <span class="eyebrow label">Llamadas</span>
        <div class="value"><%= it.total_llamadas %></div>
        <div class="foot">analizadas en total</div>
      </div>
      <div class="kpi tend">
        <span class="eyebrow label">Tendencia</span>
        <div class="value"><%= TEND[it.tendencia_equipo] || it.tendencia_equipo %></div>
        <div class="foot">vs. periodo anterior</div>
      </div>
    </div>
  </section>

  <!-- ── Resumen ejecutivo ─────────────────────────────────────────────────── -->
  <section>
    <div class="resumen">
      <span class="eyebrow">Resumen ejecutivo</span>
      <% if (it.kpi_bullets && it.kpi_bullets.length > 0) { %>
        <ul class="var-list">
        <% for (const b of it.kpi_bullets) { %>
          <li>
            <span class="arrow <%= arrowClass(b.tendencia) %>"><%= arrowChar(b.tendencia) %></span>
            <span><%= b.label %>: <b><%= b.valor %></b><% if (b.variacion) { %>&nbsp;<span class="<%= b.tendencia === 'baja' ? 'down-txt' : b.tendencia === 'mejora' ? 'up-txt' : '' %>">(<%= b.variacion %>)</span><% } %></span>
          </li>
        <% } %>
        </ul>
        <hr class="divisor">
      <% } %>
      <p><%= it.resumen_ejecutivo %></p>
    </div>
  </section>

  <!-- ── Ranking ───────────────────────────────────────────────────────────── -->
  <section>
    <span class="eyebrow">Desempeño individual</span>
    <h2 class="title">Ranking del equipo</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:6%;">#</th>
            <th>Asesor</th>
            <th style="width:15%;">Prom. score</th>
            <th style="width:13%;">Variación</th>
            <th style="width:12%;text-align:center;">Llamadas</th>
            <th style="width:17%;">Nivel</th>
          </tr>
        </thead>
        <tbody>
        <% for (const r of it.ranking) { %>
          <tr>
            <td class="num"><b><%= r.posicion %></b></td>
            <td class="col-asesor"><%= r.asesor %></td>
            <td class="num"><b><%= r.avg_score %></b>/100</td>
            <td class="num">
              <% if (r.delta_score !== undefined && r.delta_score !== null) { %>
                <span class="delta <%= r.delta_score >= 0 ? 'up' : 'down' %>"><%= fmtDelta(r.delta_score) %> pts</span>
              <% } else { %>
                <span style="color:#9a9a9a;font-size:8pt;">Primer per.</span>
              <% } %>
            </td>
            <td class="num" style="text-align:center;"><%= r.call_count %></td>
            <td><span class="chip nivel-<%= r.nivel %>"><%= it._nivelLabel(r.nivel) %></span></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Fortalezas / Áreas ────────────────────────────────────────────────── -->
  <section>
    <div class="grid-2">
      <div class="panel pos">
        <span class="eyebrow">Fortalezas del equipo</span>
        <ul>
        <% for (const f of it.fortalezas_equipo) { %>
          <li><%= f %></li>
        <% } %>
        </ul>
      </div>
      <div class="panel opp">
        <span class="eyebrow">Áreas de oportunidad</span>
        <ul>
        <% for (const a of it.areas_oportunidad) { %>
          <li><%= a %></li>
        <% } %>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Mejores prácticas ─────────────────────────────────────────────────── -->
  <% if (it.mejores_practicas && it.mejores_practicas.length > 0) { %>
  <section>
    <span class="eyebrow">Qué está funcionando</span>
    <h2 class="title">Mejores prácticas a compartir</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th style="width:17%;">Asesor</th><th style="width:24%;">Práctica</th><th>Descripción</th></tr></thead>
        <tbody>
        <% for (const mp of it.mejores_practicas) { %>
          <tr>
            <td class="col-asesor"><%= mp.asesor %></td>
            <td><b><%= mp.practica %></b></td>
            <td><%= mp.descripcion %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>

  <!-- ── Patrones de objeciones ────────────────────────────────────────────── -->
  <% if (it.patrones_objeciones && it.patrones_objeciones.length > 0) { %>
  <section>
    <span class="eyebrow">Objeciones recurrentes</span>
    <h2 class="title">Patrones de objeciones del equipo</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th style="width:24%;">Categoría</th><th style="width:22%;">Frecuencia</th><th>Recomendación</th></tr></thead>
        <tbody>
        <% for (const p of it.patrones_objeciones) { %>
          <tr>
            <td><b><%= p.categoria %></b></td>
            <td><%= p.frecuencia %></td>
            <td><%= p.recomendacion %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>

  <!-- ── Recomendaciones ───────────────────────────────────────────────────── -->
  <section>
    <span class="eyebrow">Plan de acción</span>
    <h2 class="title">Recomendaciones para el equipo</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th style="width:9%;">Prioridad</th><th style="width:18%;">Área</th><th>Acción</th><th style="width:20%;">Dirigido a</th></tr></thead>
        <tbody>
        <% for (const r of it.recomendaciones) { %>
          <tr>
            <td><span class="pill <%= r.prioridad %>"><%= r.prioridad %></span></td>
            <td><b><%= r.area %></b></td>
            <td><%= r.descripcion %></td>
            <td style="font-size:8.5pt;color:var(--text-muted);"><%= r.dirigido_a %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

</main>
</body>
</html>
