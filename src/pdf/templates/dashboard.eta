<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Dashboard · <%= it.client_name %></title>
<style>
  <%~ it._fontsCss %>

  :root {
    --bg: #FFFFFF; --surface: #FFFFFF; --surface-2: #F9FAFB;
    --text: #0A0A0A; --text-muted: #737373;
    --border: rgba(10,10,10,.10); --border-strong: rgba(10,10,10,.14);
    --r-card: 12px; --r-chip: 6px;
    --sans: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }

  @page {
    size: A4;
    margin: 12mm 0 16mm 0;
    @bottom-right { content: counter(page) " / " counter(pages); font-family: 'JetBrains Mono', monospace; font-size: 8pt; color: #9a9a9a; padding: 0 18mm 0 0; }
    @bottom-left  { content: "ZEBRA · Inteligencia Comercial"; font-family: 'JetBrains Mono', monospace; font-size: 7.5pt; letter-spacing: .12em; color: #b4b4b4; padding: 0 0 0 18mm; }
  }
  @page :first { margin-top: 0; }

  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { font-family: var(--sans); font-size: 10pt; color: var(--text); margin: 0; line-height: 1.5; orphans: 3; widows: 3; font-feature-settings: 'cv05' 1, 'ss01' 1; }

  .eyebrow { font-family: var(--mono); font-size: 7.5pt; font-weight: 500; text-transform: uppercase; letter-spacing: .2em; color: var(--text-muted); }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

  .membrete { position: relative; overflow: hidden; background: var(--text); color: #fff; padding: 20mm 18mm 14mm 18mm; page-break-after: avoid; isolation: isolate; }
  .membrete .motif { position: absolute; inset: 0 0 0 auto; width: 42%; height: 100%; background-image: url("data:image/png;base64,<%= it._motifB64 %>"); background-size: cover; background-position: right center; opacity: .10; z-index: -1; }
  .membrete img.logo { height: 22pt; display: block; margin: 0 0 12pt -1pt; }
  .membrete .eyebrow { color: rgba(255,255,255,.62); }
  .membrete .titulo { font-size: 21pt; font-weight: 600; letter-spacing: -.02em; margin: 14pt 0 2pt 0; }
  .membrete .sub { font-size: 9.5pt; color: rgba(255,255,255,.72); font-family: var(--mono); letter-spacing: .02em; }
  .membrete .meta { margin-top: 16pt; border-top: 1px solid rgba(255,255,255,.14); padding-top: 10pt; display: flex; gap: 28pt; font-size: 8pt; color: rgba(255,255,255,.6); }
  .membrete .meta b { color: #fff; font-weight: 600; }

  main { padding: 9mm 18mm 6mm 18mm; }
  section { margin-top: 16pt; page-break-inside: avoid; }
  section > .eyebrow { display: block; margin-bottom: 7pt; }
  h2.title { font-size: 12.5pt; font-weight: 600; letter-spacing: -.01em; margin: 0 0 8pt 0; page-break-after: avoid; }

  .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 12pt; }
  .chart-img { width: 100%; max-width: 660px; display: block; margin: 0 auto; }
  .chart-empty { font-size: 9pt; color: var(--text-muted); padding: 14pt 0; text-align: center; }

  .table-wrap { border: 1px solid var(--border); border-radius: var(--r-card); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; }
  thead { display: table-header-group; }
  th { background: var(--text); color: #fff; text-align: left; font-family: var(--mono); font-weight: 500; font-size: 7pt; text-transform: uppercase; letter-spacing: .09em; padding: 7pt 9pt; }
  td { padding: 7pt 9pt; border-top: 1px solid var(--border); vertical-align: top; }
  tbody tr:nth-child(even) td { background: var(--surface-2); }
  table { page-break-inside: auto; }
  tr { page-break-inside: avoid; break-inside: avoid; }
</style>
</head>
<body>

<header class="membrete">
  <span class="motif"></span>
  <% if (it._logoB64) { %>
    <img class="logo" src="data:image/png;base64,<%= it._logoB64 %>" alt="ZEBRA">
  <% } %>
  <span class="eyebrow">Inteligencia Comercial · Dashboard de Métricas</span>
  <div class="titulo"><%= it.client_name %></div>
  <div class="sub"><%= it.granularity_label %> · <%= it.from %> a <%= it.to %></div>
  <div class="meta">
    <div><b>Vista</b> · <%= it.granularity_label %></div>
    <div><b>Generado</b> · <%= it.generated_date %></div>
  </div>
</header>

<main>

  <section>
    <span class="eyebrow">Evolución</span>
    <h2 class="title">Tendencia del equipo</h2>
    <div class="chart-card">
      <% if (it.team_trend_image) { %>
        <img class="chart-img" src="<%= it.team_trend_image %>" alt="Tendencia del equipo">
      <% } else { %>
        <p class="chart-empty">Sin datos suficientes para graficar la tendencia en este rango.</p>
      <% } %>
    </div>
  </section>

  <section>
    <span class="eyebrow">Comparativo</span>
    <h2 class="title">Ranking de asesores<% if (it.buckets.length > 0) { %> · <%= it.buckets[it.buckets.length - 1].label %><% } %></h2>
    <div class="chart-card">
      <% if (it.ranking_image) { %>
        <img class="chart-img" src="<%= it.ranking_image %>" alt="Ranking de asesores">
      <% } else { %>
        <p class="chart-empty">Sin asesores con datos en el último periodo del rango.</p>
      <% } %>
    </div>
  </section>

  <section>
    <span class="eyebrow">Detalle</span>
    <h2 class="title">Resumen por asesor y periodo</h2>
    <% if (it.advisors.length === 0) { %>
      <div class="chart-card"><p class="chart-empty">Aún no hay datos para este cliente en el rango seleccionado.</p></div>
    <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Asesor</th><th>Periodo</th>
            <th style="text-align:right;">Puntaje</th>
            <th style="text-align:right;">% Sig. paso</th>
            <th style="text-align:right;">Talk ratio</th>
          </tr>
        </thead>
        <tbody>
        <% const bucketLabel = function(key) { const b = it.buckets.find(function(x) { return x.key === key; }); return b ? b.label : key; }; %>
        <% for (const advisor of it.advisors) { %>
          <% for (const point of (it.by_advisor[advisor] || [])) { %>
          <tr>
            <td><b><%= advisor %></b></td>
            <td><%= bucketLabel(point.bucket) %></td>
            <td class="num" style="text-align:right;"><%= point.avg_score !== null ? point.avg_score : 'N/D' %></td>
            <td class="num" style="text-align:right;"><%= point.pct_siguiente !== null ? point.pct_siguiente + '%' : 'N/D' %></td>
            <td class="num" style="text-align:right;"><%= point.talk_ratio !== null ? point.talk_ratio + '%' : 'N/D' %></td>
          </tr>
          <% } %>
        <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

</main>
</body>
</html>
