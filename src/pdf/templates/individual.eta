<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte <%= it.asesor %> · <%= it.mes_label %></title>
<style>
  <%~ it._fontsCss %>

  /* ── Zebra Design System · tokens (impresión = siempre light) ─────────────── */
  :root {
    --bg: #FFFFFF; --surface: #FFFFFF; --surface-2: #F9FAFB;
    --text: #0A0A0A; --text-muted: #737373; --accent: #0A0A0A;
    --ink-100: #F1F1F1; --ink-200: #E5E5E5; --ink-700: #262626;
    --border: rgba(10,10,10,.10); --border-strong: rgba(10,10,10,.14);
    --r-card: 12px; --r-chip: 6px; --r-control: 8px;
    --sans: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --pos: #1E6B30;      --pos-bg: #E9F3EC;   --pos-bd: #C4E2CD;
    --danger: #B4231C;   --danger-bg: #FBEBEA; --danger-bd: #F0CFCD;
    --warn: #8A6300;     --warn-bg: #FBF3DA;   --warn-bd: #ECDDA8;
    --orange: #B35A00;   --orange-bg: #FBEEDD; --orange-bd: #F0D6B4;
  }

  @page {
    size: A4;
    margin: 12mm 0 16mm 0;
    @bottom-right { content: counter(page) " / " counter(pages); font-family: 'JetBrains Mono', monospace; font-size: 8pt; color: #9a9a9a; padding: 0 18mm 0 0; }
    @bottom-left  { content: "ZEBRA · Inteligencia Comercial"; font-family: 'JetBrains Mono', monospace; font-size: 7.5pt; letter-spacing: .12em; color: #b4b4b4; padding: 0 0 0 18mm; }
  }
  @page :first { margin-top: 0; }

  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { font-family: var(--sans); font-size: 10pt; color: var(--text); margin: 0; line-height: 1.5; orphans: 3; widows: 3; font-feature-settings: 'cv05' 1, 'ss01' 1; }

  .eyebrow { font-family: var(--mono); font-size: 7.5pt; font-weight: 500; text-transform: uppercase; letter-spacing: .2em; color: var(--text-muted); }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

  /* ── Membrete ─────────────────────────────────────────────────────────────── */
  .membrete { position: relative; overflow: hidden; background: var(--text); color: #fff; padding: 20mm 18mm 14mm 18mm; page-break-after: avoid; isolation: isolate; }
  .membrete .motif { position: absolute; inset: 0 0 0 auto; width: 42%; height: 100%; background-image: url("data:image/png;base64,<%= it._motifB64 %>"); background-size: cover; background-position: right center; opacity: .10; z-index: -1; }
  .membrete img.logo { height: 22pt; display: block; margin: 0 0 12pt -1pt; }
  .membrete .eyebrow { color: rgba(255,255,255,.62); }
  .membrete .titulo { font-size: 21pt; font-weight: 600; letter-spacing: -.02em; margin: 14pt 0 2pt 0; }
  .membrete .sub { font-size: 9.5pt; color: rgba(255,255,255,.72); font-family: var(--mono); letter-spacing: .02em; }
  .membrete .meta { margin-top: 16pt; border-top: 1px solid rgba(255,255,255,.14); padding-top: 10pt; display: flex; gap: 28pt; font-size: 8pt; color: rgba(255,255,255,.6); }
  .membrete .meta b { color: #fff; font-weight: 600; }

  main { padding: 9mm 18mm 6mm 18mm; }
  section { margin-top: 15pt; }
  section > .eyebrow { display: block; margin-bottom: 7pt; }
  h2.title { font-size: 12.5pt; font-weight: 600; letter-spacing: -.01em; margin: 0 0 7pt 0; page-break-after: avoid; }
  h3.sub { font-size: 9.5pt; font-weight: 600; margin: 11pt 0 4pt 0; }

  /* ── KPI cards + nivel ────────────────────────────────────────────────────── */
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8pt; }
  .kpi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 11pt 12pt; page-break-inside: avoid; }
  .kpi .label { display: block; margin-bottom: 7pt; }
  .kpi .value { font-family: var(--mono); font-weight: 700; font-size: 23pt; letter-spacing: -.03em; line-height: 1; color: var(--text); }
  .kpi .value .unit { font-size: 10pt; font-weight: 500; color: var(--text-muted); letter-spacing: 0; }
  .kpi .foot { font-size: 7.5pt; color: var(--text-muted); margin-top: 5pt; }
  .nivel-row { margin-top: 9pt; display: flex; align-items: center; gap: 8pt; }
  .nivel-row .eyebrow { color: var(--text-muted); }

  .chip { display: inline-block; font-family: var(--mono); font-size: 6.5pt; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: 2pt 8pt; border-radius: var(--r-chip); border: 1px solid var(--border-strong); color: var(--text); white-space: nowrap; }
  .chip.nivel-excelente, .chip.nivel-bueno { background: var(--pos-bg); color: var(--pos); border-color: var(--pos-bd); }
  .chip.nivel-aceptable       { background: var(--warn-bg);   color: var(--warn);   border-color: var(--warn-bd); }
  .chip.nivel-necesita_mejora { background: var(--orange-bg); color: var(--orange); border-color: var(--orange-bd); }
  .chip.nivel-critico         { background: var(--danger-bg); color: var(--danger); border-color: var(--danger-bd); }

  .up-txt { color: var(--pos); font-weight: 600; }
  .down-txt { color: var(--danger); font-weight: 600; }

  /* ── Resumen ─────────────────────────────────────────────────────────────── */
  .resumen { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 13pt 15pt; margin-top: 9pt; page-break-inside: avoid; }
  .resumen .eyebrow { display: block; margin-bottom: 8pt; }
  .resumen p { margin: 0; font-size: 9.5pt; line-height: 1.6; }

  /* ── Barras de criterio (semáforo) ────────────────────────────────────────── */
  .bar-row { margin: 7pt 0; page-break-inside: avoid; }
  .bar-row .head { display: flex; justify-content: space-between; font-size: 9pt; margin-bottom: 3pt; }
  .bar-row .head .pct { font-family: var(--mono); font-size: 8pt; color: var(--text-muted); }
  .bar-track { background: var(--ink-100); height: 6pt; border-radius: 999px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 999px; }
  .bar-fill.high { background: var(--pos); }
  .bar-fill.mid  { background: var(--text); }
  .bar-fill.low  { background: var(--danger); }

  /* ── Tablas ──────────────────────────────────────────────────────────────── */
  .table-wrap { border: 1px solid var(--border); border-radius: var(--r-card); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; }
  thead { display: table-header-group; }
  th { background: var(--text); color: #fff; text-align: left; vertical-align: middle; font-family: var(--mono); font-weight: 500; font-size: 7pt; text-transform: uppercase; letter-spacing: .09em; padding: 7pt 9pt; }
  td { padding: 7pt 9pt; border-top: 1px solid var(--border); vertical-align: top; line-height: 1.5; }
  tbody tr:nth-child(even) td { background: var(--surface-2); }
  tr { page-break-inside: avoid; break-inside: avoid; }

  /* ── Citas (ejemplos textuales) ───────────────────────────────────────────── */
  .cita { background: var(--surface-2); border-left: 2px solid var(--border-strong); padding: 6pt 10pt; margin: 4pt 0; font-size: 8.5pt; color: #333; border-radius: 0 var(--r-control) var(--r-control) 0; page-break-inside: avoid; }
  .cita.buena { border-left-color: var(--pos); }
  .cita.mala  { border-left-color: var(--danger); }
  .cita .label { display: block; font-family: var(--mono); font-size: 6.5pt; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); margin-bottom: 3pt; }
  .objecion-bloque { page-break-inside: avoid; margin-bottom: 10pt; }

  /* ── Nota / alerta ────────────────────────────────────────────────────────── */
  .nota { border-top: 1px solid var(--border); padding: 7pt 0 0 0; margin: 9pt 0 0 0; font-size: 8.5pt; color: var(--text-muted); }
  .nota b { color: var(--text); font-weight: 600; }
  .nota.warn { border-top-color: var(--warn-bd); color: var(--warn); }
  .nota.warn b { color: var(--warn); }

  /* ── Paneles de dos columnas ──────────────────────────────────────────────── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; page-break-inside: avoid; }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 12pt 13pt; }
  .panel .eyebrow { display: block; margin-bottom: 9pt; }
  .panel ul { list-style: none; margin: 0; padding: 0; }
  .panel li { position: relative; padding-left: 13pt; margin-bottom: 8pt; font-size: 8.7pt; line-height: 1.5; }
  .panel li:last-child { margin-bottom: 0; }
  .panel li::before { content: ""; position: absolute; left: 0; top: 5pt; width: 6pt; height: 6pt; border-radius: 1.5px; }
  .panel.pos { border-top: 2px solid var(--pos); }
  .panel.pos .eyebrow { color: var(--pos); }
  .panel.pos li::before { background: var(--pos); }
  .panel.opp { border-top: 2px solid var(--danger); }
  .panel.opp .eyebrow { color: var(--danger); }
  .panel.opp li::before { background: var(--danger); }
  .panel li b { font-weight: 600; }

  .kv { width: 100%; border-collapse: collapse; font-size: 9pt; }
  .kv td { padding: 5pt 0; border-top: 1px solid var(--border); }
  .kv tr:first-child td { border-top: none; }
  .kv td:last-child { text-align: right; font-family: var(--mono); font-weight: 600; }

  /* ── Callouts mejor / peor llamada ────────────────────────────────────────── */
  .callout { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card); padding: 12pt 13pt; page-break-inside: avoid; }
  .callout.best  { border-top: 2px solid var(--pos); }
  .callout.worst { border-top: 2px solid var(--danger); }
  .callout .head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5pt; }
  .callout .head .lbl { font-family: var(--mono); font-size: 7pt; text-transform: uppercase; letter-spacing: .1em; }
  .callout.best  .head .lbl { color: var(--pos); }
  .callout.worst .head .lbl { color: var(--danger); }
  .callout .score { font-family: var(--mono); font-weight: 700; font-size: 15pt; letter-spacing: -.02em; }
  .callout .meta { font-size: 8pt; color: var(--text-muted); margin-bottom: 4pt; }
  .callout p { margin: 0; font-size: 8.7pt; line-height: 1.5; }
  .btn-rec { display: inline-block; margin-top: 8pt; background: var(--text); color: #fff; text-decoration: none; font-family: var(--mono); font-size: 7.5pt; font-weight: 500; letter-spacing: .04em; padding: 5pt 11pt; border-radius: var(--r-control); }

  .pill { display: inline-block; font-family: var(--mono); font-size: 6.5pt; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: 2pt 8pt; border-radius: var(--r-chip); white-space: nowrap; }
  .pill.alta  { background: var(--text); color: #fff; border: 1px solid var(--text); }
  .pill.media { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
  .pill.baja  { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }
</style>
</head>
<body>

<%
const barClass = function(pct){ return pct >= 75 ? 'high' : pct >= 40 ? 'mid' : 'low'; };
const fmtDelta = function(n){ return (n >= 0 ? '+' : '') + n; };
const tipoLabel = it.tipo_asesor === 'desconocido' ? 'asesor' : it.tipo_asesor;
%>

<header class="membrete">
  <span class="motif"></span>
  <% if (it._logoB64) { %>
    <img class="logo" src="data:image/png;base64,<%= it._logoB64 %>" alt="ZEBRA">
  <% } %>
  <span class="eyebrow">Inteligencia Comercial · Análisis de Llamadas</span>
  <div class="titulo"><%= it.asesor %></div>
  <div class="sub"><%= it.mes_label %><% if (it.period_label) { %> · <%= it.period_label %><% } %> · <%= it.call_count %> videollamada<%= it.call_count !== 1 ? 's' : '' %></div>
  <div class="meta">
    <div><b>Perfil</b> · <%= tipoLabel %></div>
    <div><b>Llamadas</b> · <%= it.call_count %></div>
    <div><b>Generado</b> · <%= it.generated_date %></div>
  </div>
</header>

<main>

  <!-- ── KPIs ──────────────────────────────────────────────────────────────── -->
  <section style="margin-top:0;">
    <div class="kpis">
      <div class="kpi">
        <span class="eyebrow label">Puntaje promedio</span>
        <div class="value"><%= it.avg_score %><span class="unit">/100</span></div>
        <div class="foot">
          σ = <%= it.score_sigma %> · rango <%= it.score_min %>–<%= it.score_max %>
          <% if (it.has_previous && it.delta_score !== undefined) { %>
            · <span class="<%= it.delta_score >= 0 ? 'up-txt' : 'down-txt' %>"><%= fmtDelta(it.delta_score) %> pts</span>
          <% } else if (!it.has_previous) { %>
            · primer periodo
          <% } %>
        </div>
      </div>
      <div class="kpi">
        <span class="eyebrow label">Objeciones / llamada</span>
        <div class="value"><%= it.objeciones_por_llamada %></div>
        <div class="foot">resuelve <%= it.tasa_resolucion_global %>%</div>
      </div>
      <div class="kpi">
        <span class="eyebrow label">Logra siguiente paso</span>
        <div class="value"><%= it.pct_logra_siguiente_paso %><span class="unit">%</span></div>
        <div class="foot">
          de las llamadas
          <% if (it.has_previous && it.delta_siguiente_paso !== undefined) { %>
            · <span class="<%= it.delta_siguiente_paso >= 0 ? 'up-txt' : 'down-txt' %>"><%= fmtDelta(it.delta_siguiente_paso) %> pp</span>
          <% } %>
        </div>
      </div>
    </div>
    <div class="nivel-row">
      <span class="eyebrow">Nivel general</span>
      <span class="chip nivel-<%= it.nivel %>"><%= it.nivel.replace('_', ' ') %></span>
    </div>
  </section>

  <!-- ── Resumen ───────────────────────────────────────────────────────────── -->
  <section style="margin-top:11pt;">
    <div class="resumen">
      <span class="eyebrow">Resumen ejecutivo</span>
      <p><%= it.resumen %></p>
    </div>
  </section>

  <!-- ── Desempeño por criterio ────────────────────────────────────────────── -->
  <section>
    <span class="eyebrow">Evaluación</span>
    <h2 class="title">Desempeño por criterio</h2>
    <% for (const c of it.criterios) { %>
      <div class="bar-row">
        <div class="head">
          <span><b><%= c.nombre %></b></span>
          <span class="pct"><%= c.puntaje %>/<%= c.max_puntaje %> · <%= c.porcentaje %>%</span>
        </div>
        <div class="bar-track"><div class="bar-fill <%= barClass(c.porcentaje) %>" style="width: <%= c.porcentaje %>%;"></div></div>
      </div>
    <% } %>
  </section>

  <!-- ── Cobertura de producto ─────────────────────────────────────────────── -->
  <% if (it.elementos_producto && it.elementos_producto.length > 0) { %>
  <section>
    <span class="eyebrow">Modelo comercial</span>
    <h2 class="title">Cobertura de información del producto</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Elemento</th><th style="text-align:right;width:20%;">% Llamadas</th></tr></thead>
        <tbody>
        <% for (const e of it.elementos_producto) { %>
          <tr><td><%= e.elemento %></td><td class="num" style="text-align:right;"><%= e.pct_llamadas %>%</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <% if (it.elementos_subutilizados && it.elementos_subutilizados.length > 0) { %>
      <div class="nota"><b>Elementos subutilizados:</b> <%= it.elementos_subutilizados.join(', ') %></div>
    <% } %>
  </section>
  <% } %>

  <!-- ── Objeciones ────────────────────────────────────────────────────────── -->
  <% if (it.objeciones && it.objeciones.length > 0) { %>
  <section>
    <span class="eyebrow">Manejo de objeciones</span>
    <h2 class="title">Top <%= it.objeciones.length %> objeciones más frecuentes</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:5%;">#</th><th>Categoría</th>
            <th style="text-align:center;width:9%;">Veces</th>
            <th style="text-align:center;width:12%;">% Llam.</th>
            <th style="text-align:center;width:14%;">Resolución</th>
            <th style="width:26%;">Técnicas</th>
          </tr>
        </thead>
        <tbody>
        <% for (let i = 0; i < it.objeciones.length; i++) { const o = it.objeciones[i]; %>
          <tr>
            <td class="num"><b><%= i + 1 %></b></td>
            <td><b><%= o.categoria %></b></td>
            <td class="num" style="text-align:center;"><%= o.veces %></td>
            <td class="num" style="text-align:center;"><%= o.pct_llamadas %>%</td>
            <td class="num" style="text-align:center;"><b class="<%= o.tasa_resolucion >= 60 ? 'up-txt' : 'down-txt' %>"><%= o.tasa_resolucion %>%</b></td>
            <td><%= o.tecnicas %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>

    <h3 class="sub">Ejemplos textuales por categoría</h3>
    <% for (let i = 0; i < it.objeciones.length; i++) { const o = it.objeciones[i]; %>
      <div class="objecion-bloque">
        <h3 class="sub" style="margin-top:8pt;"><%= i + 1 %>. <%= o.categoria %></h3>
        <div class="cita"><span class="label">Objeción del lead</span><%= o.ejemplo_objecion %></div>
        <div class="cita buena"><span class="label">Respuesta efectiva</span><%= o.ejemplo_respuesta_efectiva %></div>
        <div class="cita mala"><span class="label">Respuesta que no resuelve</span><%= o.ejemplo_respuesta_fallida %></div>
      </div>
    <% } %>

    <% if (it.categorias_peor_manejadas && it.categorias_peor_manejadas.length > 0) { %>
      <h3 class="sub">Categorías peor manejadas</h3>
      <div class="panel opp" style="border-top:none;">
        <ul>
        <% for (const cat of it.categorias_peor_manejadas) { %>
          <li><b><%= cat.categoria %>:</b> <%= cat.consejo %></li>
        <% } %>
        </ul>
      </div>
    <% } %>
  </section>
  <% } %>

  <!-- ── Sesgos ────────────────────────────────────────────────────────────── -->
  <% if (it.sesgos && it.sesgos.length > 0) { %>
  <section>
    <span class="eyebrow">Persuasión</span>
    <h2 class="title">Uso de sesgos cognitivos</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Sesgo</th><th style="text-align:center;width:22%;">Prom. / llamada</th><th style="text-align:center;width:26%;">% Llamadas</th></tr></thead>
        <tbody>
        <% for (const s of it.sesgos) { %>
          <tr>
            <td><b><%= s.nombre %></b></td>
            <td class="num" style="text-align:center;"><%= s.promedio_por_llamada %></td>
            <td class="num" style="text-align:center;"><%= s.pct_llamadas %>%</td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <% if (it.sesgos_subutilizados && it.sesgos_subutilizados.length > 0) { %>
      <div class="nota"><b>Sesgos subutilizados:</b> <%= it.sesgos_subutilizados.join(', ') %></div>
    <% } %>
  </section>
  <% } %>

  <!-- ── Conversación + Cierres ────────────────────────────────────────────── -->
  <section>
    <div class="grid-2">
      <div class="panel">
        <span class="eyebrow">Conversación</span>
        <table class="kv">
          <tr><td>Talk ratio del vendedor</td><td><%= it.talk_ratio %>%</td></tr>
          <tr><td>Preguntas promedio</td><td><%= it.preguntas_promedio %></td></tr>
        </table>
        <% if (it.talk_ratio > 70) { %>
          <div class="nota warn"><b>Talk ratio elevado:</b> el vendedor habla demasiado y el lead apenas participa.</div>
        <% } %>
      </div>
      <div class="panel">
        <span class="eyebrow">Cierres</span>
        <table class="kv">
          <tr><td>Apartado</td><td><%= it.cierres.apartado %></td></tr>
          <tr><td>Cita de seguimiento</td><td><%= it.cierres.cita_seguimiento %></td></tr>
          <tr><td>Firma</td><td><%= it.cierres.firma %></td></tr>
          <tr><td>Fecha de decisión</td><td><%= it.cierres.fecha_decision %></td></tr>
          <tr><td>Sin siguiente paso</td><td><span class="<%= it.cierres.sin_siguiente_paso > 0 ? 'down-txt' : '' %>"><%= it.cierres.sin_siguiente_paso %></span></td></tr>
        </table>
      </div>
    </div>
  </section>

  <!-- ── Fortalezas / Debilidades ──────────────────────────────────────────── -->
  <section>
    <div class="grid-2">
      <div class="panel pos">
        <span class="eyebrow">Fortalezas recurrentes</span>
        <ul>
        <% for (const f of it.fortalezas) { %>
          <li><b><%= f.descripcion %></b> (<%= f.pct_llamadas %>% de llamadas)<% if (f.cita) { %><div class="cita buena" style="margin-top:4pt;"><%= f.cita %></div><% } %></li>
        <% } %>
        </ul>
      </div>
      <div class="panel opp">
        <span class="eyebrow">Debilidades recurrentes</span>
        <ul>
        <% for (const d of it.debilidades) { %>
          <li><b><%= d.descripcion %></b> (<%= d.pct_llamadas %>%) — <span style="font-family:var(--mono);font-size:7.5pt;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);">impacto <%= d.impacto %></span></li>
        <% } %>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Videollamadas destacadas ──────────────────────────────────────────── -->
  <section>
    <span class="eyebrow">Videollamadas destacadas</span>
    <div class="grid-2">
      <div class="callout best">
        <div class="head"><span class="lbl">Mejor llamada</span><span class="score"><%= it.mejor_llamada.score %>/100</span></div>
        <div class="meta"><%= it.mejor_llamada.fecha %> · Lead: <%= it.mejor_llamada.lead %></div>
        <p><%= it.mejor_llamada.descripcion %></p>
        <% if (it.mejor_llamada_record_url) { %>
          <a class="btn-rec" href="<%= it.mejor_llamada_record_url %>">▶ Escuchar grabación</a>
        <% } %>
      </div>
      <div class="callout worst">
        <div class="head"><span class="lbl">Peor llamada</span><span class="score"><%= it.peor_llamada.score %>/100</span></div>
        <div class="meta"><%= it.peor_llamada.fecha %> · Lead: <%= it.peor_llamada.lead %></div>
        <p><%= it.peor_llamada.descripcion %></p>
      </div>
    </div>
  </section>

  <!-- ── Recomendaciones ───────────────────────────────────────────────────── -->
  <section>
    <span class="eyebrow">Plan de acción</span>
    <h2 class="title">Recomendaciones de acción</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th style="width:9%;">Prioridad</th><th style="width:18%;">Área</th><th>Acción</th><th style="width:22%;">Métrica a mover</th></tr></thead>
        <tbody>
        <% for (const r of it.recomendaciones) { %>
          <tr>
            <td><span class="pill <%= r.prioridad %>"><%= r.prioridad %></span></td>
            <td><b><%= r.area %></b></td>
            <td><%= r.accion %></td>
            <td style="font-size:8.5pt;color:var(--text-muted);"><%= r.metrica %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

</main>
</body>
</html>
