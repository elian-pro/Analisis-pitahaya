<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte <%= it.asesor %> — <%= it.mes_label %></title>
<style>
  @page {
    size: A4;
    margin: 0;
    @bottom-right {
      content: "Página " counter(page) " / " counter(pages);
      font-family: 'Helvetica', sans-serif;
      font-size: 9pt;
      color: #999;
      padding: 0 20mm 10mm 0;
    }
  }
  * { box-sizing: border-box; }
  body { font-family: 'Helvetica', 'Arial', sans-serif; font-size: 10pt; color: #1a1a1a; margin: 0; line-height: 1.45; orphans: 3; widows: 3; }
  .membrete { background: #0a0a0a; color: #fafafa; padding: 25mm 20mm 18mm 20mm; margin-bottom: 0; page-break-after: avoid; }
  .membrete .marca { font-size: 28pt; font-weight: 900; letter-spacing: -1px; margin: 0; }
  .membrete .marca .dot { color: #d4af37; }
  .membrete .tagline { font-size: 9pt; color: #b0b0b0; margin-top: 4px; letter-spacing: 2px; text-transform: uppercase; }
  .membrete .meta { margin-top: 22pt; border-top: 1px solid #2a2a2a; padding-top: 14pt; display: flex; justify-content: space-between; }
  .membrete .meta div { font-size: 8.5pt; color: #888; }
  .membrete .meta b { color: #fafafa; font-weight: 600; }
  .barra-oro { background: #d4af37; height: 3px; }
  main { padding: 12mm 20mm 18mm 20mm; }
  h1 { font-size: 18pt; margin: 18pt 0 4pt 0; font-weight: 800; letter-spacing: -0.3px; }
  h1 .sub { font-size: 10pt; font-weight: 400; color: #777; display: block; margin-top: 2pt; }
  h2 { font-size: 12pt; margin: 18pt 0 8pt 0; padding-bottom: 4pt; border-bottom: 2px solid #0a0a0a; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; page-break-after: avoid; }
  h3 { font-size: 10pt; margin: 12pt 0 4pt 0; font-weight: 700; color: #d4af37; }
  p { margin: 0 0 6pt 0; }
  .resumen { background: #f6f5f1; border-left: 3px solid #d4af37; padding: 10pt 12pt; margin-top: 8pt; font-size: 10pt; line-height: 1.55; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8pt; margin: 10pt 0 8pt 0; }
  .kpi { background: #f6f5f1; border: 1px solid #e3e0d6; padding: 8pt 10pt; border-radius: 4px; }
  .kpi .label { font-size: 7.5pt; color: #777; text-transform: uppercase; letter-spacing: 0.5px; }
  .kpi .value { font-size: 18pt; font-weight: 800; color: #0a0a0a; margin-top: 2pt; }
  .kpi .footer { font-size: 7.5pt; color: #999; margin-top: 2pt; }
  table { width: 100%; border-collapse: collapse; margin: 6pt 0 8pt 0; font-size: 9pt; }
  th { background: #0a0a0a; color: #fff; padding: 5pt 7pt; text-align: left; font-weight: 600; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.3px; }
  td { padding: 5pt 7pt; border-bottom: 1px solid #e3e0d6; vertical-align: top; }
  tr:nth-child(even) td { background: #faf9f6; }
  .bar-row { margin: 6pt 0; }
  .bar-row .head { display: flex; justify-content: space-between; font-size: 9pt; margin-bottom: 2pt; }
  .bar-row .head .pct { color: #777; }
  .bar-track { background: #ececec; height: 6pt; border-radius: 3px; overflow: hidden; }
  .bar-fill { background: linear-gradient(90deg, #0a0a0a, #d4af37); height: 100%; }
  .bar-fill.low  { background: #c44; }
  .bar-fill.mid  { background: #d4af37; }
  .bar-fill.high { background: #2c8f3a; }
  ul { padding-left: 18pt; margin: 4pt 0 8pt 0; }
  li { margin-bottom: 3pt; }
  .cita { background: #faf9f6; border-left: 2px solid #d4af37; padding: 6pt 10pt; margin: 4pt 0; font-style: italic; font-size: 9pt; color: #444; }
  .cita.mala { border-left-color: #c44; }
  .cita .label { font-style: normal; font-weight: 700; color: #777; font-size: 8pt; text-transform: uppercase; display: block; margin-bottom: 2pt; letter-spacing: 0.4px; }
  .pill { display: inline-block; padding: 1pt 6pt; border-radius: 8pt; font-size: 8pt; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
  .pill.alta  { background: #fde8e8; color: #b51e1e; }
  .pill.media { background: #fff4d6; color: #8a6b00; }
  .pill.baja  { background: #e5f3ea; color: #1e6b30; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14pt; }
  .grid-2 .col h3 { margin-top: 0; }
  .nivel-badge { display: inline-block; padding: 3pt 10pt; border-radius: 12pt; font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .nivel-excelente       { background: #e5f3ea; color: #1e6b30; }
  .nivel-bueno           { background: #e5efea; color: #2c5f3a; }
  .nivel-aceptable       { background: #fff4d6; color: #8a6b00; }
  .nivel-necesita_mejora { background: #ffe6cc; color: #b35a00; }
  .nivel-critico         { background: #fde8e8; color: #b51e1e; }
  .alert { background: #fff4d6; border-left: 3px solid #d4af37; padding: 8pt 12pt; margin: 6pt 0; font-size: 9pt; }
  .kpi, .kpis { page-break-inside: avoid; break-inside: avoid; }
  .cita { page-break-inside: avoid; break-inside: avoid; }
  .bar-row { page-break-inside: avoid; break-inside: avoid; }
  .objecion-bloque { page-break-inside: avoid; break-inside: avoid; margin-bottom: 10pt; }
  .grid-short { page-break-inside: avoid; break-inside: avoid; }
  table { page-break-inside: auto; }
  tr { page-break-inside: avoid; break-inside: avoid; }
  thead { display: table-header-group; }
  li { page-break-inside: avoid; break-inside: avoid; }
</style>
</head>
<body>

<header class="membrete">
  <p class="marca">ZEBRA<span class="dot">.</span></p>
  <p class="tagline">Inteligencia comercial · Análisis de cierres</p>
  <div class="meta">
    <div><b>Reporte:</b> Desempeño mensual de <%= it.tipo_asesor === 'desconocido' ? 'asesor' : it.tipo_asesor %></div>
    <div><b>Generado:</b> <%= it.generated_date %></div>
  </div>
</header>
<div class="barra-oro"></div>

<main>

<%
const barClass = function(pct) { return pct >= 75 ? 'high' : pct >= 40 ? 'mid' : 'low'; };
const resColor  = function(n)   { return n >= 80 ? '#1e6b30' : '#b51e1e'; };
const impactoDisplay = function(v) { return 'impacto ' + (v === 'alta' ? 'alto' : v === 'media' ? 'medio' : 'bajo'); };
%>

<h1><%= it.asesor %>
  <span class="sub"><%= it.mes_label %> · <%= it.call_count %> videollamada<%= it.call_count !== 1 ? 's' : '' %> analizadas</span>
</h1>

<div class="kpis">
  <div class="kpi">
    <div class="label">Puntaje promedio</div>
    <div class="value"><%= it.avg_score %><span style="font-size:11pt;color:#777;">/100</span></div>
    <div class="footer">σ = <%= it.score_sigma %></div>
  </div>
  <div class="kpi">
    <div class="label">Objeciones / llamada</div>
    <div class="value"><%= it.objeciones_por_llamada %></div>
    <div class="footer">resuelve <%= it.tasa_resolucion_global %>%</div>
  </div>
  <div class="kpi">
    <div class="label">Logra siguiente paso</div>
    <div class="value"><%= it.pct_logra_siguiente_paso %>%</div>
    <div class="footer">de las llamadas</div>
  </div>
</div>

<p style="margin-top:10pt;">
  <span class="nivel-badge nivel-<%= it.nivel %>"><%= it.nivel.replace('_', ' ') %></span>
</p>

<div class="resumen"><%= it.resumen %></div>

<!-- === Desempeño por criterio === -->
<div class="seccion">
<h2>Desempeño por criterio</h2>
<% for (const c of it.criterios) { %>
  <div class="bar-row">
    <div class="head">
      <span><b><%= c.nombre %></b></span>
      <span class="pct"><%= c.puntaje %> pts · <%= c.porcentaje %>%</span>
    </div>
    <div class="bar-track"><div class="bar-fill <%= barClass(c.porcentaje) %>" style="width: <%= c.porcentaje %>%;"></div></div>
  </div>
<% } %>
</div>

<!-- === Cobertura de información del producto === -->
<% if (it.elementos_producto && it.elementos_producto.length > 0) { %>
<div class="seccion">
<h2>Cobertura de información del producto</h2>
<p style="font-size:9pt;color:#666;margin-bottom:6pt;">Porcentaje de llamadas donde el vendedor mencionó cada elemento del modelo.</p>
<table>
  <thead><tr><th>Elemento</th><th style="text-align:right;width:18%;">% Llamadas</th></tr></thead>
  <tbody>
  <% for (const e of it.elementos_producto) { %>
    <tr><td><%= e.elemento %></td><td style="text-align:right;"><%= e.pct_llamadas %>%</td></tr>
  <% } %>
  </tbody>
</table>
<% if (it.elementos_subutilizados && it.elementos_subutilizados.length > 0) { %>
<div class="alert"><b>⚠️ Subutilizados:</b> <%= it.elementos_subutilizados.join(', ') %></div>
<% } %>
</div>
<% } %>

<!-- === Top objeciones === -->
<% if (it.objeciones && it.objeciones.length > 0) { %>
<div class="seccion">
<h2>Top <%= it.objeciones.length %> objeciones más frecuentes</h2>
<table>
  <thead>
    <tr>
      <th>#</th><th>Categoría</th><th style="text-align:center;">Veces</th>
      <th style="text-align:center;">% Llamadas</th><th style="text-align:center;">Tasa resolución</th>
      <th>Técnicas más usadas</th>
    </tr>
  </thead>
  <tbody>
  <% for (let i = 0; i < it.objeciones.length; i++) { const o = it.objeciones[i]; %>
    <tr>
      <td><b><%= i + 1 %></b></td>
      <td><b><%= o.categoria %></b></td>
      <td style="text-align:center;"><%= o.veces %></td>
      <td style="text-align:center;"><%= o.pct_llamadas %>%</td>
      <td style="text-align:center;"><b style="color: <%= resColor(o.tasa_resolucion) %>;"><%= o.tasa_resolucion %>%</b></td>
      <td><%= o.tecnicas %></td>
    </tr>
  <% } %>
  </tbody>
</table>

<h3>Ejemplos textuales por categoría</h3>
<% for (let i = 0; i < it.objeciones.length; i++) { const o = it.objeciones[i]; %>
  <div class="objecion-bloque">
    <h3 style="color:#0a0a0a;margin-top:8pt;margin-bottom:4pt;"><%= i + 1 %>. <%= o.categoria %></h3>
    <div class="cita"><span class="label">Objeción del lead</span><%= o.ejemplo_objecion %></div>
    <div class="cita"><span class="label">✓ Respuesta efectiva</span><%= o.ejemplo_respuesta_efectiva %></div>
    <div class="cita mala"><span class="label">✗ Respuesta no resuelve</span><%= o.ejemplo_respuesta_fallida %></div>
  </div>
<% } %>

<% if (it.categorias_peor_manejadas && it.categorias_peor_manejadas.length > 0) { %>
<h3>Categorías peor manejadas</h3>
<ul>
<% for (const cat of it.categorias_peor_manejadas) { %>
  <li><b><%= cat.categoria %></b>: <%= cat.consejo %></li>
<% } %>
</ul>
<% } %>
</div>
<% } %>

<!-- === Sesgos cognitivos === -->
<% if (it.sesgos && it.sesgos.length > 0) { %>
<div class="seccion">
<h2>Uso de sesgos cognitivos</h2>
<table>
  <thead><tr><th>Sesgo</th><th style="text-align:center;">Promedio / llamada</th><th style="text-align:center;">% Llamadas donde lo usa</th></tr></thead>
  <tbody>
  <% for (const s of it.sesgos) { %>
    <tr>
      <td><b><%= s.nombre %></b></td>
      <td style="text-align:center;"><%= s.promedio_por_llamada %></td>
      <td style="text-align:center;"><%= s.pct_llamadas %>%</td>
    </tr>
  <% } %>
  </tbody>
</table>
<% if (it.sesgos_subutilizados && it.sesgos_subutilizados.length > 0) { %>
<div class="alert"><b>⚠️ Sesgos subutilizados:</b> <%= it.sesgos_subutilizados.join(', ') %></div>
<% } %>
</div>
<% } %>

<!-- === Conversación + Cierres === -->
<div class="seccion">
<div class="grid-2 grid-short">
  <div class="col">
    <h2 style="border:none;font-size:11pt;">Conversación</h2>
    <table>
      <tr><td>Talk ratio vendedor</td><td style="text-align:right;"><b><%= it.talk_ratio %>%</b></td></tr>
      <tr><td>Preguntas promedio</td><td style="text-align:right;"><b><%= it.preguntas_promedio %></b></td></tr>
    </table>
    <% if (it.talk_ratio > 70) { %>
    <div class="alert">⚠️ Talk ratio elevado: el vendedor habla demasiado y el lead apenas participa.</div>
    <% } %>
  </div>
  <div class="col">
    <h2 style="border:none;font-size:11pt;">Cierres</h2>
    <table>
      <tr><td>Apartado</td><td style="text-align:right;"><b><%= it.cierres.apartado %></b></td></tr>
      <tr><td>Cita seguimiento</td><td style="text-align:right;"><b><%= it.cierres.cita_seguimiento %></b></td></tr>
      <tr><td>Firma</td><td style="text-align:right;"><b><%= it.cierres.firma %></b></td></tr>
      <tr><td>Fecha de decisión</td><td style="text-align:right;"><b><%= it.cierres.fecha_decision %></b></td></tr>
      <tr><td>Sin siguiente paso</td><td style="text-align:right;"><b><%= it.cierres.sin_siguiente_paso %></b></td></tr>
    </table>
  </div>
</div>
</div>

<!-- === Fortalezas / Debilidades === -->
<div class="seccion">
<div class="grid-2">
  <div class="col">
    <h2 style="border:none;font-size:11pt;color:#1e6b30;">✓ Fortalezas recurrentes</h2>
    <ul>
    <% for (const f of it.fortalezas) { %>
      <li><b><%= f.descripcion %></b> (<%= f.pct_llamadas %>% de llamadas)
      <% if (f.cita) { %>
        <div class="cita" style="margin-top:4pt;"><%= f.cita %></div>
      <% } %>
      </li>
    <% } %>
    </ul>
  </div>
  <div class="col">
    <h2 style="border:none;font-size:11pt;color:#b51e1e;">✗ Debilidades recurrentes</h2>
    <ul>
    <% for (const d of it.debilidades) { %>
      <li><b><%= d.descripcion %></b> (<%= d.pct_llamadas %>%) <span class="pill <%= d.impacto %>"><%= impactoDisplay(d.impacto) %></span></li>
    <% } %>
    </ul>
  </div>
</div>
</div>

<!-- === Llamadas destacadas === -->
<div class="seccion">
<h2>Videollamadas destacadas</h2>
<div class="grid-2 grid-short">
  <div class="col">
    <h3 style="color:#1e6b30;">★ Mejor llamada — <%= it.mejor_llamada.score %>/100</h3>
    <p style="font-size:9pt;color:#666;"><%= it.mejor_llamada.fecha %> · Lead: <%= it.mejor_llamada.lead %></p>
    <p><%= it.mejor_llamada.descripcion %></p>
  </div>
  <div class="col">
    <h3 style="color:#b51e1e;">▼ Peor llamada — <%= it.peor_llamada.score %>/100</h3>
    <p style="font-size:9pt;color:#666;"><%= it.peor_llamada.fecha %> · Lead: <%= it.peor_llamada.lead %></p>
    <p><%= it.peor_llamada.descripcion %></p>
  </div>
</div>
</div>

<!-- === Recomendaciones === -->
<div class="seccion">
<h2>Recomendaciones de acción</h2>
<table>
  <thead><tr><th style="width:9%;">Prioridad</th><th style="width:18%;">Área</th><th>Acción</th><th style="width:22%;">Métrica a mover</th></tr></thead>
  <tbody>
  <% for (const r of it.recomendaciones) { %>
    <tr>
      <td><span class="pill <%= r.prioridad %>"><%= r.prioridad %></span></td>
      <td><%= r.area %></td>
      <td><%= r.accion %></td>
      <td style="font-size:9pt;color:#444;"><%= r.metrica %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

</main>
</body>
</html>
